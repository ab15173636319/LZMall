# ==========================================================
# LZMall market server - 本地开发变量（与 application.yml 的占位符一一对应）
#
# 本文件由 application.yml 的 spring.config.import 以 properties 格式导入，
# 因此请遵守 properties 写法：
#   1. 值不要加引号（"root" 会连引号一起当成值）
#   2. 不要写 export 前缀
#   3. 等号两边不要留空格
#   4. 需要注释用 #
#
# 生效优先级（高 -> 低）：
#   命令行参数 --server.port=9090  >  -DSERVER_PORT=9090  >  操作系统环境变量
#   >  本文件 .env  >  application.yml 里的默认值
# ==========================================================

# ===== 应用 =====
SERVER_PORT=8080

# ===== MySQL 数据源 =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lzmall
DB_USERNAME=root
DB_PASSWORD=root

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
# 无密码留空即可
REDIS_PASSWORD=
REDIS_DB=0

# ===== JWT（生产环境务必替换）=====
JWT_SECRET=lzmall-dev-secret-key-change-me-0123456789
JWT_EXPIRE_MINUTES=120
